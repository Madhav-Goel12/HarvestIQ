generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Recommendation {
  id        Int      @id @default(autoincrement())
  crop      String
  soil      String
  season    String
  createdAt DateTime @default(now())
}
